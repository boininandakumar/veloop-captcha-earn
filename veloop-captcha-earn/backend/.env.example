# Server
PORT=5000
NODE_ENV=development

# MongoDB (use your own MongoDB Atlas cluster - never commit real values)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/veloop_captcha?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CAPTCHA config
CAPTCHA_EXPIRY_SECONDS=120
CAPTCHA_CORRECT_REWARD=1
CAPTCHA_WRONG_REWARD=0.5

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Frontend origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
